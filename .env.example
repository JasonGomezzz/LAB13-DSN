# Copia este archivo a .env y ajusta los valores.
# Los valores reales NUNCA se suben al repositorio.

# Servidor
PORT=3000

# AWS
AWS_REGION=us-east-1
DYNAMODB_TABLE=empleados
S3_BUCKET=lab13-empleados-fotos-cambia-este-nombre

# Solo para desarrollo local con LocalStack (docker compose up -d).
# En AWS real deja AWS_ENDPOINT_URL vacío y usa un perfil de AWS CLI (AWS_PROFILE)
# o el rol de la instancia EC2; no pongas claves reales en este archivo.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# AWS_PROFILE=

# Fotos
MAX_FOTO_MB=2
